DATABASE_URL=postgres://postgres:postgres@localhost:5432/farm_communication
PORT=4000
HOST=0.0.0.0
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.yourorg.farmconnect
APNS_PRIVATE_KEY=
APNS_USE_PRODUCTION=false
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Legacy shared ingest key. Kept only for nodes already in the field; leave blank to disable.
SENSOR_INGEST_API_KEY=
LEGACY_FARM_ID=farm_legacy

# Transactional email (password reset + address verification). Unset = codes are logged, not sent.
RESEND_API_KEY=
MAIL_FROM=
MAIL_APP_NAME=Persephone's Basket

# Ops sensor-health alerts (comma-separated). Who gets emailed when a node looks faulty.
OPS_ALERT_EMAILS=
# SENSOR_HEALTH_CHECK_MINUTES=120
# SENSOR_HEALTH_CHECK_DISABLED=false

# Comma-separated addresses granted staff access on sign-in. Set this to create the first admin.
ADMIN_BOOTSTRAP_EMAILS=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o
OPENROUTER_MODERATION_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=FarmAlert

# Fertilizer/partner demo. Store only SHA-256 of the partner key, never the raw key.
PARTNER_API_KEY_HASH=
PARTNER_FARM_1_ID=
PARTNER_FARM_2_ID=
